/* ==========================================================================
   SAFFRON TABLE — RESTAURANT WEBSITE STYLESHEET
   Built with pure CSS3 (Flexbox, Grid & Media Queries — No frameworks)
   --------------------------------------------------------------------------
   TABLE OF CONTENTS
   1. Color Variables & Reset
   2. Base Typography & Reusable Classes
   3. Navigation Bar (Header)
   4. Hero Section
   5. About Us Section
   6. Our Menu Section
   7. Special Offers Section
   8. Gallery Section
   9. Contact Section & Form
   10. Footer
   11. Responsive Design (Media Queries)
       - Laptops:  769px to 1024px
       - Tablets:  481px to 768px
       - Mobile:   320px to 480px
   12. Accessibility: Reduced Motion
   ========================================================================== */


/* ==========================================================================
   1. COLOR VARIABLES & BASIC RESET
   ========================================================================== */

:root {
  /* Main Theme Colors */
  --color-primary: #b84a27;        /* Warm terracotta spice */
  --color-primary-dark: #94391c;   /* Deeper terracotta for hover */
  --color-gold: #e0a642;           /* Saffron gold highlight */
  --color-gold-soft: #f5d48f;      /* Light gold for dark backgrounds */
  --color-dark: #211713;           /* Rich espresso brown */
  --color-darker: #160f0c;         /* Deep footer background */

  /* Surface & Text Colors */
  --color-bg-light: #fbf8f3;       /* Warm cream surface */
  --color-bg-warm: #f3ece1;        /* Soft linen accent surface */
  --color-white: #ffffff;          /* Clean card background */
  --color-text: #2a201b;           /* Main readable dark text */
  --color-muted: #66584f;          /* Softer body text */
  --color-border: rgba(33, 23, 19, 0.11);

  /* Fonts */
  --font-heading: "Playfair Display", Georgia, serif;
  --font-body: "DM Sans", "Segoe UI", Arial, sans-serif;

  /* Spacing & Shape */
  --max-width: 1180px;
  --radius-lg: 16px;
  --radius-md: 10px;
  --radius-pill: 999px;

  /* Shadows & Motion */
  --shadow-card: 0 10px 28px rgba(33, 23, 19, 0.07);
  --shadow-hover: 0 20px 44px rgba(33, 23, 19, 0.14);
  --transition: 0.3s ease;
}

/* Remove default spacing and keep sizing predictable */
*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 82px;
}

body {
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.65;
  color: var(--color-text);
  background-color: var(--color-bg-light);
  overflow-x: hidden; /* Prevents horizontal scroll on mobile */
  -webkit-font-smoothing: antialiased;
}

img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

ul {
  list-style: none;
}

address {
  font-style: normal;
}

button,
input,
textarea {
  font-family: inherit;
  font-size: inherit;
}

/* Keyboard focus outline */
:focus-visible {
  outline: 3px solid var(--color-gold);
  outline-offset: 3px;
}


/* ==========================================================================
   2. BASE TYPOGRAPHY & REUSABLE CLASSES
   ========================================================================== */

/* Centered page wrapper with side padding */
.container {
  width: 100%;
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 24px;
}

/* Standard top & bottom padding for every section */
.section {
  padding: 88px 0;
}

h1,
h2,
h3 {
  font-family: var(--font-heading);
  font-weight: 600;
  line-height: 1.2;
  color: var(--color-dark);
}

h2 {
  font-size: clamp(2rem, 3.6vw, 2.85rem);
}

h2 em {
  font-style: italic;
  font-weight: 500;
  color: var(--color-primary);
}

h3 {
  font-size: 1.35rem;
}

/* Shared centered section heading block */
.section-header {
  max-width: 640px;
  margin: 0 auto 52px;
  text-align: center;
}

.section-label {
  display: inline-block;
  margin-bottom: 10px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-primary);
}

.section-label-light {
  color: var(--color-gold-soft);
}

.section-subtitle {
  margin-top: 12px;
  font-size: 1rem;
  color: var(--color-muted);
}

.section-header-light h2 {
  color: var(--color-white);
}

.section-header-light h2 em {
  color: var(--color-gold-soft);
}

.section-header-light .section-subtitle {
  color: rgba(255, 255, 255, 0.78);
}

/* Screen-reader only helper text */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
}

/* Skip link visible when tabbed via keyboard */
.skip-link {
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 999;
  padding: 10px 16px;
  border-radius: var(--radius-md);
  background-color: var(--color-primary);
  color: var(--color-white);
  font-size: 0.875rem;
  font-weight: 600;
  transform: translateY(-160%);
  transition: transform var(--transition);
}

.skip-link:focus {
  transform: translateY(0);
}

/* Reusable Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14px 28px;
  border-radius: var(--radius-pill);
  border: 2px solid transparent;
  font-size: 0.92rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  cursor: pointer;
  transition:
    background-color var(--transition),
    color var(--transition),
    border-color var(--transition),
    transform var(--transition),
    box-shadow var(--transition);
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-primary {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-white);
  box-shadow: 0 8px 20px rgba(184, 74, 39, 0.28);
}

.btn-primary:hover {
  background-color: var(--color-primary-dark);
  border-color: var(--color-primary-dark);
  box-shadow: 0 12px 26px rgba(184, 74, 39, 0.36);
}

.btn-secondary {
  background-color: var(--color-dark);
  border-color: var(--color-dark);
  color: var(--color-white);
}

.btn-secondary:hover {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.btn-outline-light {
  background-color: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.7);
  color: var(--color-white);
}

.btn-outline-light:hover {
  background-color: var(--color-white);
  border-color: var(--color-white);
  color: var(--color-dark);
}

.btn-gold {
  background-color: var(--color-gold);
  border-color: var(--color-gold);
  color: var(--color-darker);
}

.btn-gold:hover {
  background-color: var(--color-gold-soft);
  border-color: var(--color-gold-soft);
  box-shadow: 0 10px 24px rgba(224, 166, 66, 0.32);
}

.btn-full {
  width: 100%;
}


/* ==========================================================================
   3. NAVIGATION BAR (HEADER)
   ========================================================================== */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: rgba(251, 248, 243, 0.96);
  border-bottom: 1px solid var(--color-border);
  backdrop-filter: blur(10px);
}

.header-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  min-height: 78px;
}

/* Brand Logo & Name */
.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.brand-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  color: var(--color-primary);
  transition: transform var(--transition);
}

.brand-icon svg {
  width: 100%;
  height: 100%;
}

.brand:hover .brand-icon {
  transform: scale(1.06);
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-weight: 700;
  line-height: 1.1;
  color: var(--color-dark);
}

.brand-sub {
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-top: 2px;
}

/* Desktop Navigation List */
.nav-list {
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav-list a {
  position: relative;
  font-size: 0.92rem;
  font-weight: 500;
  color: var(--color-text);
  padding: 6px 0;
  transition: color var(--transition);
}

/* Animated bottom underline on hover */
.nav-list a:not(.nav-contact-btn)::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 2px;
  background-color: var(--color-primary);
  transform: scaleX(0);
  transform-origin: left center;
  transition: transform var(--transition);
}

.nav-list a:not(.nav-contact-btn):hover {
  color: var(--color-primary);
}

.nav-list a:not(.nav-contact-btn):hover::after {
  transform: scaleX(1);
}

/* Highlighted Contact pill link */
.nav-list .nav-contact-btn {
  padding: 10px 22px;
  border-radius: var(--radius-pill);
  background-color: var(--color-primary);
  color: var(--color-white);
  font-weight: 600;
  transition: background-color var(--transition), transform var(--transition);
}

.nav-list .nav-contact-btn:hover {
  background-color: var(--color-primary-dark);
  color: var(--color-white);
  transform: translateY(-1px);
}

/* Mobile Checkbox & Hamburger Button (Hidden on Desktop) */
.menu-toggle {
  display: none;
}

.menu-toggle:focus-visible + .menu-toggle-label {
  outline: 3px solid var(--color-gold);
  outline-offset: 3px;
}

.menu-toggle-label {
  display: none;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  width: 44px;
  height: 44px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background-color: var(--color-white);
  cursor: pointer;
}

.menu-toggle-label .bar {
  display: block;
  width: 22px;
  height: 2px;
  background-color: var(--color-dark);
  border-radius: 2px;
  transition: transform var(--transition), opacity var(--transition);
}


/* ==========================================================================
   4. HERO SECTION
   ========================================================================== */

.hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 620px;
  padding: 96px 0 72px;
  color: var(--color-white);
  background-color: var(--color-dark);
  /* Full-width food background photo with warm dark gradient overlay */
  background-image:
    linear-gradient(
      110deg,
      rgba(22, 14, 10, 0.88) 0%,
      rgba(28, 18, 13, 0.72) 52%,
      rgba(28, 18, 13, 0.42) 100%
    ),
    url("https://images.pexels.com/photos/8585881/pexels-photo-8585881.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=627&w=1200");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero-eyebrow {
  display: inline-block;
  margin-bottom: 16px;
  padding: 6px 14px;
  border: 1px solid rgba(245, 212, 143, 0.42);
  border-radius: var(--radius-pill);
  background-color: rgba(22, 14, 10, 0.45);
  color: var(--color-gold-soft);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.hero h1 {
  color: var(--color-white);
  font-size: clamp(2.8rem, 6.2vw, 4.9rem);
  font-weight: 700;
  line-height: 1.06;
  letter-spacing: -0.01em;
}

.hero-tagline {
  margin-top: 12px;
  font-family: var(--font-heading);
  font-size: clamp(1.35rem, 2.6vw, 2rem);
  font-weight: 400;
  color: var(--color-gold-soft);
}

.hero-tagline em {
  font-style: italic;
}

.hero-description {
  max-width: 560px;
  margin-top: 18px;
  font-size: 1.02rem;
  line-height: 1.75;
  color: rgba(255, 255, 255, 0.88);
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 30px;
}

/* Info bar below the Hero CTA */
.hero-info {
  display: flex;
  flex-wrap: wrap;
  gap: 28px 44px;
  margin-top: 56px;
  padding-top: 26px;
  border-top: 1px solid rgba(255, 255, 255, 0.2);
}

.hero-info-item {
  display: flex;
  flex-direction: column;
}

.hero-info-label {
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-gold-soft);
}

.hero-info-value {
  margin-top: 4px;
  font-size: 0.96rem;
  font-weight: 500;
  color: var(--color-white);
}


/* ==========================================================================
   5. ABOUT US SECTION (Two-Column Layout)
   ========================================================================== */

.about-section {
  background-color: var(--color-bg-light);
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1.05fr;
  align-items: center;
  gap: 56px;
}

.about-image-wrap {
  position: relative;
  border-radius: var(--radius-lg);
}

.about-image-wrap img {
  height: 460px;
  object-fit: cover;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-hover);
  transition: transform 0.6s ease;
}

.about-image-wrap:hover img {
  transform: scale(1.02);
}

/* Experience badge in bottom corner */
.about-badge {
  position: absolute;
  right: -16px;
  bottom: 24px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 22px;
  border-radius: var(--radius-md);
  background-color: var(--color-primary);
  color: var(--color-white);
  box-shadow: 0 14px 32px rgba(33, 23, 19, 0.24);
}

.about-badge strong {
  font-family: var(--font-heading);
  font-size: 2rem;
  line-height: 1;
}

.about-badge span {
  font-size: 0.76rem;
  font-weight: 500;
  line-height: 1.35;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.about-content h2 {
  margin-bottom: 18px;
}

.about-lead {
  font-size: 1.08rem;
  font-weight: 500;
  color: var(--color-dark);
  margin-bottom: 14px;
}

.about-text {
  color: var(--color-muted);
  margin-bottom: 28px;
}

/* Three small quality cards inside About */
.about-highlights {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 30px;
  padding-top: 22px;
  border-top: 1px solid var(--color-border);
}

.highlight-item h3 {
  font-family: var(--font-body);
  font-size: 0.94rem;
  font-weight: 700;
  color: var(--color-dark);
  margin-bottom: 4px;
}

.highlight-item p {
  font-size: 0.84rem;
  line-height: 1.5;
  color: var(--color-muted);
}


/* ==========================================================================
   6. OUR MENU SECTION (CSS Grid of 6 Dish Cards)
   ========================================================================== */

.menu-section {
  background-color: var(--color-bg-warm);
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}

.menu-card {
  display: flex;
  flex-direction: column;
  background-color: var(--color-white);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
}

.menu-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-hover);
  border-color: rgba(184, 74, 39, 0.35);
}

.menu-card-image {
  position: relative;
  height: 220px;
  overflow: hidden;
  background-color: #e6ddd0;
}

.menu-card-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.55s ease;
}

/* Smooth zoom on hover */
.menu-card:hover .menu-card-image img {
  transform: scale(1.07);
}

/* Subtle pill label over the photo */
.menu-tag {
  position: absolute;
  top: 14px;
  left: 14px;
  padding: 5px 12px;
  border-radius: var(--radius-pill);
  background-color: rgba(251, 248, 243, 0.94);
  color: var(--color-dark);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.menu-card-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  padding: 22px 24px 24px;
}

.menu-card-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
}

.menu-card-top h3 {
  font-size: 1.48rem;
  color: var(--color-dark);
}

.menu-price {
  font-family: var(--font-heading);
  font-size: 1.32rem;
  font-weight: 700;
  color: var(--color-primary);
  white-space: nowrap;
}

.menu-card-desc {
  font-size: 0.92rem;
  line-height: 1.65;
  color: var(--color-muted);
  margin-bottom: 18px;
}

/* Pushes bottom details evenly to the bottom of every card */
.menu-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-top: auto;
  padding-top: 14px;
  border-top: 1px solid var(--color-border);
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--color-muted);
}


/* ==========================================================================
   7. SPECIAL OFFERS SECTION (Dark Editorial Banner & Cards)
   ========================================================================== */

.offers-section {
  background-color: var(--color-dark);
  background-image:
    radial-gradient(circle at 12% 15%, rgba(184, 74, 39, 0.24), transparent 44%),
    radial-gradient(circle at 90% 85%, rgba(224, 166, 66, 0.16), transparent 42%);
  color: var(--color-white);
}

/* Large Featured Weekend Banner */
.offer-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 36px;
  padding: 40px 44px;
  margin-bottom: 28px;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(245, 212, 143, 0.28);
  background: linear-gradient(135deg, #3c1c13 0%, #5e2918 55%, #8f3a1e 100%);
  box-shadow: 0 22px 48px rgba(0, 0, 0, 0.3);
}

.offer-banner-content {
  max-width: 660px;
}

.offer-pill {
  display: inline-block;
  padding: 5px 14px;
  margin-bottom: 14px;
  border-radius: var(--radius-pill);
  background-color: rgba(245, 212, 143, 0.16);
  border: 1px solid rgba(245, 212, 143, 0.42);
  color: var(--color-gold-soft);
  font-size: 0.74rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.offer-banner h3 {
  color: var(--color-white);
  font-size: clamp(1.65rem, 3vw, 2.25rem);
  margin-bottom: 12px;
}

.offer-banner p {
  color: rgba(255, 255, 255, 0.88);
  font-size: 0.98rem;
  line-height: 1.7;
}

.offer-banner .offer-validity {
  margin-top: 12px;
  font-size: 0.82rem;
  color: var(--color-gold-soft);
}

.offer-banner-highlight {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  flex-shrink: 0;
  padding: 20px 28px;
  border-radius: var(--radius-md);
  background-color: rgba(22, 14, 10, 0.36);
  border: 1px solid rgba(245, 212, 143, 0.24);
}

.offer-big {
  font-family: var(--font-heading);
  font-size: 3.2rem;
  font-weight: 700;
  line-height: 1;
  color: var(--color-gold-soft);
}

.offer-big-label {
  margin: 4px 0 18px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.24em;
  color: var(--color-white);
}

/* Three Smaller Offer Cards */
.offers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.offer-card {
  display: flex;
  flex-direction: column;
  padding: 30px 26px;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(255, 255, 255, 0.14);
  background-color: rgba(255, 255, 255, 0.05);
  transition: transform var(--transition), border-color var(--transition), background-color var(--transition);
}

.offer-card:hover {
  transform: translateY(-5px);
  border-color: rgba(245, 212, 143, 0.55);
  background-color: rgba(255, 255, 255, 0.09);
}

.offer-card-accent {
  border-color: rgba(224, 166, 66, 0.45);
  background-color: rgba(224, 166, 66, 0.1);
}

.offer-badge {
  align-self: flex-start;
  padding: 4px 12px;
  margin-bottom: 16px;
  border-radius: var(--radius-pill);
  background-color: rgba(224, 166, 66, 0.18);
  color: var(--color-gold-soft);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.offer-card h3 {
  color: var(--color-white);
  font-size: 1.4rem;
  margin-bottom: 6px;
}

.offer-price-tag {
  font-family: var(--font-body);
  font-size: 1.02rem;
  font-weight: 700;
  color: var(--color-gold);
  margin-bottom: 12px;
}

.offer-desc {
  font-size: 0.9rem;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.78);
}


/* ==========================================================================
   8. GALLERY SECTION (Responsive CSS Grid)
   ========================================================================== */

.gallery-section {
  background-color: var(--color-bg-light);
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
}

.gallery-item {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 4 / 3;
  background-color: #e6ddd0;
  box-shadow: var(--shadow-card);
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

/* Smooth dark gradient caption resting neatly at the bottom */
.gallery-item figcaption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 36px 20px 16px;
  background: linear-gradient(to top, rgba(22, 14, 10, 0.82) 0%, rgba(22, 14, 10, 0) 100%);
  color: var(--color-white);
  font-size: 0.9rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  transition: padding-bottom var(--transition);
}

.gallery-item:hover img {
  transform: scale(1.07);
}

.gallery-item:hover figcaption {
  padding-bottom: 20px;
}


/* ==========================================================================
   9. CONTACT SECTION & FORM
   ========================================================================== */

.contact-section {
  background-color: var(--color-bg-warm);
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.08fr;
  gap: 36px;
  align-items: start;
}

/* Left Column: 4 Info Cards */
.contact-info {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.info-card {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 22px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  background-color: var(--color-white);
  box-shadow: var(--shadow-card);
  transition: transform var(--transition), border-color var(--transition);
}

.info-card:hover {
  transform: translateY(-2px);
  border-color: rgba(184, 74, 39, 0.35);
}

.info-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  background-color: rgba(184, 74, 39, 0.1);
  color: var(--color-primary);
}

.info-icon svg {
  width: 20px;
  height: 20px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.info-card h3 {
  font-family: var(--font-body);
  font-size: 0.98rem;
  font-weight: 700;
  color: var(--color-dark);
  margin-bottom: 4px;
}

.info-card p,
.info-card address {
  font-size: 0.92rem;
  color: var(--color-text);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.info-card a {
  color: var(--color-primary);
  font-weight: 600;
  transition: color var(--transition);
}

.info-card a:hover {
  color: var(--color-primary-dark);
  text-decoration: underline;
}

.info-card .info-note {
  margin-top: 2px;
  font-size: 0.82rem;
  color: var(--color-muted);
}

/* Opening hours two-column rows */
.hours-wrap {
  flex: 1;
  min-width: 0;
}

.hours-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 6px;
}

.hours-list li {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-size: 0.88rem;
  color: var(--color-muted);
  padding-bottom: 6px;
  border-bottom: 1px dashed var(--color-border);
}

.hours-list li:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.hours-list li span:last-child {
  font-weight: 600;
  color: var(--color-dark);
  text-align: right;
}

/* Right Column: Contact Form Card */
.contact-form-card {
  padding: 36px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  border-top: 4px solid var(--color-primary);
  background-color: var(--color-white);
  box-shadow: var(--shadow-card);
}

.contact-form-card h3 {
  font-size: 1.7rem;
  margin-bottom: 6px;
}

.form-intro {
  font-size: 0.92rem;
  color: var(--color-muted);
  margin-bottom: 24px;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-group label {
  font-size: 0.86rem;
  font-weight: 600;
  color: var(--color-dark);
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 13px 15px;
  border: 1.5px solid #ddd3c6;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-light);
  color: var(--color-text);
  font-size: 0.95rem;
  transition: border-color var(--transition), background-color var(--transition), box-shadow var(--transition);
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #93857b;
}

.form-group input:focus,
.form-group textarea:focus {
  outline: none;
  border-color: var(--color-primary);
  background-color: var(--color-white);
  box-shadow: 0 0 0 4px rgba(184, 74, 39, 0.14);
}

.form-group textarea {
  resize: vertical;
  min-height: 120px;
}

.form-disclaimer {
  font-size: 0.78rem;
  line-height: 1.55;
  color: var(--color-muted);
  text-align: center;
}


/* ==========================================================================
   10. FOOTER
   ========================================================================== */

.site-footer {
  background-color: var(--color-darker);
  color: rgba(255, 255, 255, 0.78);
  padding-top: 64px;
  border-top: 3px solid var(--color-primary);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr;
  gap: 44px;
  padding-bottom: 48px;
}

.brand-light {
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  margin-bottom: 14px;
}

.brand-light .brand-name {
  color: var(--color-white);
  font-size: 1.6rem;
}

.brand-light .brand-sub {
  color: var(--color-gold-soft);
}

.footer-about p {
  max-width: 340px;
  font-size: 0.9rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.72);
}

.footer-links h3,
.footer-social h3 {
  font-family: var(--font-body);
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-gold-soft);
  margin-bottom: 16px;
}

.footer-links ul {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-links a {
  font-size: 0.92rem;
  color: rgba(255, 255, 255, 0.78);
  transition: color var(--transition), padding-left var(--transition);
}

.footer-links a:hover {
  color: var(--color-gold-soft);
  padding-left: 5px;
}

.footer-social-text {
  font-size: 0.88rem;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 18px;
}

.social-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.22);
  color: var(--color-white);
  transition: background-color var(--transition), border-color var(--transition), transform var(--transition);
}

.social-link svg {
  width: 18px;
  height: 18px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.social-link:hover {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  transform: translateY(-3px);
}

.footer-bottom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px 24px;
  padding-top: 22px;
  padding-bottom: 24px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  font-size: 0.82rem;
  color: rgba(255, 255, 255, 0.72);
}


/* ==========================================================================
   11. RESPONSIVE DESIGN (MEDIA QUERIES)
   Desktop default: 1025px and above
   ========================================================================== */

/* --- Laptops: 769px to 1024px --- */
@media (max-width: 1024px) {
  .section {
    padding: 72px 0;
  }

  .nav-list {
    gap: 20px;
  }

  .about-grid {
    gap: 40px;
  }

  .about-image-wrap img {
    height: 410px;
  }

  .about-badge {
    right: 14px;
    bottom: 16px;
  }

  .menu-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .offer-banner {
    padding: 32px;
    gap: 24px;
  }

  .offers-grid {
    gap: 18px;
  }

  .gallery-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .contact-grid {
    gap: 28px;
  }

  .contact-form-card {
    padding: 30px;
  }
}

/* --- Tablets: 481px to 768px --- */
@media (max-width: 768px) {
  .section {
    padding: 60px 0;
  }

  .section-header {
    margin-bottom: 38px;
  }

  /* Pure CSS Hamburger Navigation Menu */
  .menu-toggle {
    display: block;
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .menu-toggle-label {
    display: flex;
  }

  .main-nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background-color: var(--color-bg-light);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 18px 34px rgba(33, 23, 19, 0.12);
    max-height: 0;
    overflow: hidden;
    visibility: hidden;
    transition: max-height 0.35s ease, visibility 0.35s ease;
  }

  /* Reveals dropdown when hidden checkbox is checked */
  .menu-toggle:checked ~ .main-nav {
    max-height: 420px;
    visibility: visible;
  }

  /* Smooth icon turn to X */
  .menu-toggle:checked + .menu-toggle-label .bar:nth-child(2) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle:checked + .menu-toggle-label .bar:nth-child(3) {
    opacity: 0;
  }

  .menu-toggle:checked + .menu-toggle-label .bar:nth-child(4) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-list {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 10px 24px 22px;
  }

  .nav-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .nav-list li:last-child {
    border-bottom: none;
    padding-top: 14px;
  }

  .nav-list a {
    display: block;
    padding: 13px 0;
    font-size: 1rem;
  }

  .nav-list a:not(.nav-contact-btn)::after {
    display: none;
  }

  .nav-list .nav-contact-btn {
    text-align: center;
    padding: 12px 20px;
  }

  /* Hero stacking */
  .hero {
    min-height: 540px;
    padding: 72px 0 56px;
  }

  .hero-info {
    gap: 20px 32px;
    margin-top: 40px;
  }

  /* About stacks to single column */
  .about-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .about-image-wrap img {
    height: 360px;
  }

  .about-highlights {
    grid-template-columns: repeat(3, 1fr);
  }

  /* Menu stays neat 2 columns on tablet */
  .menu-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  /* Special offers stack smoothly */
  .offer-banner {
    flex-direction: column;
    align-items: flex-start;
    padding: 28px 24px;
  }

  .offer-banner-highlight {
    width: 100%;
    padding: 20px;
  }

  .offers-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  /* Contact stacks cleanly */
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .footer-grid {
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .footer-about {
    grid-column: 1 / -1;
  }
}

/* --- Mobile Phones: 320px to 480px --- */
@media (max-width: 480px) {
  .container {
    padding: 0 16px;
  }

  .section {
    padding: 50px 0;
  }

  .header-inner {
    min-height: 68px;
    gap: 12px;
  }

  .brand-icon {
    width: 36px;
    height: 36px;
  }

  .brand-name {
    font-size: 1.2rem;
  }

  .brand-sub {
    font-size: 0.6rem;
    letter-spacing: 0.12em;
  }

  .hero {
    min-height: auto;
    padding: 56px 0 48px;
  }

  .hero h1 {
    font-size: 2.45rem;
  }

  .hero-tagline {
    font-size: 1.25rem;
  }

  .hero-description {
    font-size: 0.94rem;
  }

  .hero-actions {
    flex-direction: column;
  }

  .hero-actions .btn {
    width: 100%;
  }

  .hero-info {
    flex-direction: column;
    gap: 16px;
    margin-top: 32px;
    padding-top: 20px;
  }

  .about-image-wrap img {
    height: 260px;
  }

  .about-badge {
    position: static;
    margin-top: 14px;
    justify-content: center;
  }

  .about-highlights {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .about-content .btn {
    width: 100%;
  }

  /* Single-column cards for small mobile screens */
  .menu-grid,
  .gallery-grid,
  .footer-grid {
    grid-template-columns: 1fr;
  }

  .menu-card-image {
    height: 200px;
  }

  .menu-card-body {
    padding: 18px 18px 20px;
  }

  .offer-banner {
    padding: 24px 18px;
  }

  .offer-big {
    font-size: 2.6rem;
  }

  .offer-banner-highlight .btn {
    width: 100%;
  }

  .offer-card {
    padding: 24px 20px;
  }

  .info-card {
    padding: 18px 16px;
    gap: 14px;
  }

  .hours-list li {
    flex-direction: column;
    gap: 2px;
  }

  .hours-list li span:last-child {
    text-align: left;
  }

  .contact-form-card {
    padding: 24px 18px;
  }

  .footer-bottom {
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }
}


/* ==========================================================================
   12. ACCESSIBILITY: REDUCED MOTION
   ========================================================================== */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
  }
}

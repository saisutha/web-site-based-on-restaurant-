              <div class="menu-card-top">
                <h3>Pizza</h3>
                <span class="menu-price">&#8377;349</span>
              </div>
              <p class="menu-card-desc">
                Hand-stretched Margherita crust baked crisp with crushed tomatoes,
                melted fresh mozzarella, fragrant sweet basil, and extra-virgin olive oil.
              </p>
              <div class="menu-card-meta">
                <span>10-inch Regular</span>
                <span>Vegetarian</span>
              </div>
            </div>
          </article>

          <!-- Menu Card 2: Burger -->

        <!-- Three Supporting Deal Cards -->
        <div class="offers-grid">
          <article class="offer-card">
            <span class="offer-badge">Mon &ndash; Fri</span>
            <h3>Weekday Lunch Combo</h3>
            <p class="offer-price-tag">Only &#8377;399</p>

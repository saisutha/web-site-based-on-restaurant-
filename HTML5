    <!-- =========================================================
         C. ABOUT US SECTION (Two-Column Story & Interior Image)
         ========================================================= -->
    <section class="section about-section" id="about" aria-labelledby="about-heading">
      <div class="container about-grid">
        <!-- Left Column: Restaurant Image -->
        <div class="about-image-wrap">
          <img src="https://images.pexels.com/photos/31970866/pexels-photo-31970866.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=627&w=1200"
               alt="Warm modern dining room inside Saffron Table with wooden tables and pendant lights"
               width="1200" height="627" loading="lazy">
          <div class="about-badge">
            <strong>10+</strong>
            <span>Years Serving<br>Good Food</span>
          </div>
        </div>

        <!-- Right Column: Story & Highlights -->

                   width="1200" height="627" loading="lazy">
              <span class="menu-tag">Best Seller</span>
            </div>
            <div class="menu-card-body">
              <div class="menu-card-top">
                <h3>Burger</h3>
                <span class="menu-price">&#8377;249</span>
              </div>
              <p class="menu-card-desc">
                Flame-grilled patty stacked with aged cheddar cheese, caramelised onions,
                crisp lettuce, and smoky house glaze on a toasted butter brioche bun.
              </p>
              <div class="menu-card-meta">
                <span>With Seasoned Fries</span>
                <span>Veg / Classic</span>
              </div>
            </div>
          </article>

          <!-- Menu Card 3: Biryani -->
          <article class="menu-card">
            <div class="menu-card-image">
              <img src="https://images.pexels.com/photos/28674660/pexels-photo-28674660.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=627&w=1200"
                   alt="Aromatic Indian dum biryani served with rich spiced gravy and crisp garnishes"
                   width="1200" height="627" loading="lazy">
              <span class="menu-tag">House Special</span>
            </div>
            <div class="menu-card-body">
              <div class="menu-card-top">
                <h3>Biryani</h3>
                <span class="menu-price">&#8377;329</span>
              </div>
